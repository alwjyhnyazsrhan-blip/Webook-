# General
APP_NAME="Webook Sniper Platform"
DEBUG=true

# Telegram
BOT_TOKEN="your_bot_token_here"
ADMIN_IDS=[123456789]

# Database
DATABASE_URL="postgresql+asyncpg://webook_user:webook_password@localhost:5432/webook_db"

# Cache & Queue
REDIS_URL="redis://localhost:6379/0"

# Logging
LOG_LEVEL="DEBUG"
JSON_LOGS=false

# API
API_HOST="0.0.0.0"
API_PORT=8000

# CAPTCHA Solving (optional — for events with Cloudflare Turnstile)
# Get your API key from https://dashboard.capsolver.com
CAPSOLVER_API_KEY="CAP-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
# Cloudflare Turnstile sitekey used by Webook (default should work)
TURNSTILE_SITEKEY="0x4AAAAAAAEHcP_mgMtMABCk"

# Webook API & Auth Tokens (defaults work, override if rotated)
# WEBOOK_API_TOKEN="e9aac1f2f0b6c07d6be070ed14829de684264278359148d6a582ca65a50934d2"
# LOGIN_DEVICE_TOKEN="bqvtwD2zBdLC8HkUIsvwmlhMnkfifLtffml2mNNRe"
